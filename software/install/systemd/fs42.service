[Unit]
Description=FieldStation42 player
# Started and stopped by the LaserTrack daemon (channels mode on/off).
# Our own unit rather than FS42's install_services.sh, so its name and
# behaviour are known and it is never started behind the daemon's back.

[Service]
WorkingDirectory=%h/FieldStation42
# -t none: no "bad reception" effect on channel change. FS42's default draws
# static with a per-pixel CPU filter over full 1080p frames, which the Pi 4
# can't keep up with (stutter and garbled frames, 2026-11-21).
ExecStart=%h/FieldStation42/env/bin/python3 field_player.py -t none
Restart=on-failure
RestartSec=5
# Stopping must also end FS42's mpv and API server (same cgroup).
KillMode=control-group
TimeoutStopSec=10
